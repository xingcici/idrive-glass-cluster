{
  "schemaVersion": 1,
  "id": "glass-cluster",
  "name": "Glass Cluster",
  "version": "0.2.0",
  "author": "xingcici",
  "description": "Twin-ring instrument theme inspired by the blue Aston Martin CarPlay Ultra presentation. BMW factory gear area stays clear. Not official CarPlay Ultra.",
  "license": "GPL-3.0-or-later",
  "target": {
    "platform": "idrive7-mgu",
    "display": "kombi-id7-12.3",
    "renderer": "cluster-render"
  },
  "vehicleProfile": "turbo-ice",
  "layout": {
    "width": 1920,
    "height": 720,
    "background": {
      "type": "linear",
      "angle": 90,
      "stops": [
        {
          "offset": 0,
          "color": "$background-top"
        },
        {
          "offset": 0.84,
          "color": "$background"
        }
      ]
    },
    "reservedZones": [
      {
        "x": 730,
        "y": 0,
        "width": 460,
        "height": 128,
        "id": "cowl",
        "name": "Top cowl (factory telltales)",
        "kind": "factory"
      },
      {
        "x": 1410,
        "y": 262,
        "width": 252,
        "height": 192,
        "id": "gear-bracket",
        "name": "Gear bracket (factory gear display)",
        "kind": "factory"
      },
      {
        "x": 1770,
        "y": 170,
        "width": 150,
        "height": 95,
        "id": "edrive-box",
        "name": "eDrive status box (hybrids)",
        "kind": "factory"
      },
      {
        "x": 560,
        "y": 652,
        "width": 960,
        "height": 68,
        "id": "telltales-bottom",
        "name": "Bottom telltale strip",
        "kind": "factory"
      },
      {
        "x": 0,
        "y": 0,
        "width": 394.5454545454545,
        "height": 217,
        "id": "glass-corner-left",
        "name": "Glass corner (left)",
        "kind": "keep-clear",
        "polygon": [
          {
            "x": 0,
            "y": 0
          },
          {
            "x": 394.5454545454545,
            "y": 0
          },
          {
            "x": 0,
            "y": 217
          }
        ]
      },
      {
        "x": 1525.4545454545455,
        "y": 0,
        "width": 394.5454545454545,
        "height": 217,
        "id": "glass-corner-right",
        "name": "Glass corner (right)",
        "kind": "keep-clear",
        "polygon": [
          {
            "x": 1920,
            "y": 0
          },
          {
            "x": 1525.4545454545455,
            "y": 0
          },
          {
            "x": 1920,
            "y": 217
          }
        ]
      },
      {
        "x": 416,
        "y": 120,
        "width": 1088,
        "height": 480,
        "id": "stock-map-window",
        "name": "Stock map window (slot 0x100)",
        "kind": "info"
      },
      {
        "x": 0,
        "y": 646,
        "width": 1920,
        "height": 74,
        "id": "bottom-strip",
        "name": "Bottom strip (black boxes reported below y 646)",
        "kind": "info"
      },
      {
        "x": 793,
        "y": 289,
        "width": 246,
        "height": 92,
        "id": "m-box-left",
        "name": "M cars: cluster box (approx. ±10 px)",
        "kind": "info"
      },
      {
        "x": 1223,
        "y": 328,
        "width": 171,
        "height": 78,
        "id": "m-box-right",
        "name": "M cars: cluster box (approx. ±10 px)",
        "kind": "info"
      },
      {
        "x": 740,
        "y": 128,
        "width": 440,
        "height": 19,
        "id": "driver-camera",
        "name": "Driver camera notch (cars with it, to y ≈ 147)",
        "kind": "info"
      }
    ]
  },
  "palettes": {
    "graphite": {
      "name": "Graphite",
      "colors": {
        "background": "#000000",
        "surface": "#15191f",
        "text": "#f4f6fa",
        "text-muted": "#a4adb9",
        "accent": "#25c6e8",
        "track": "#114452",
        "success": "#73d8b0",
        "warning": "#ffbd69",
        "danger": "#ff6969",
        "edge": "#ffffff24",
        "background-top": "#062a36"
      }
    },
    "sport": {
      "name": "Sport",
      "colors": {
        "background": "#000000",
        "surface": "#15191f",
        "text": "#f4f6fa",
        "text-muted": "#a4adb9",
        "accent": "#ff806a",
        "track": "#482c2b",
        "success": "#73d8b0",
        "warning": "#ffbd69",
        "danger": "#ff6969",
        "edge": "#ffffff24",
        "background-top": "#281717"
      }
    },
    "eco": {
      "name": "Eco",
      "colors": {
        "background": "#000000",
        "surface": "#15191f",
        "text": "#f4f6fa",
        "text-muted": "#a4adb9",
        "accent": "#88d8b0",
        "track": "#214b40",
        "success": "#73d8b0",
        "warning": "#ffbd69",
        "danger": "#ff6969",
        "edge": "#ffffff24",
        "background-top": "#102f28"
      }
    }
  },
  "palette": {
    "default": "graphite",
    "byDriveMode": {
      "SPORT": "sport",
      "SPORT_PLUS": "sport",
      "ECO_PRO": "eco"
    },
    "allowManual": true
  },
  "fonts": {
    "default": {
      "family": "sans"
    }
  },
  "assets": {},
  "animations": {},
  "components": [
    {
      "id": "speed-ring",
      "name": "Rev arc",
      "x": 159,
      "y": 150,
      "width": 450,
      "height": 450,
      "rotation": 0,
      "opacity": 1,
      "visible": true,
      "locked": false,
      "anchor": "top-left",
      "binding": {
        "signal": "vehicle.speed",
        "min": 0,
        "max": 260,
        "scale": 1,
        "offset": 0,
        "clamp": true,
        "smoothing": 0,
        "fallback": "dash"
      },
      "animations": [],
      "type": "gauge.arc",
      "props": {
        "startAngle": 135,
        "sweepAngle": 270,
        "track": {
          "show": true,
          "color": "$track",
          "width": 12,
          "cap": "butt"
        },
        "fill": {
          "show": true,
          "color": "$accent",
          "width": 12,
          "mode": "solid",
          "segments": 40,
          "segmentGap": 1.5,
          "cap": "butt",
          "zones": []
        },
        "ticks": {
          "major": 0,
          "minor": 0,
          "majorLength": 9,
          "minorLength": 7,
          "majorWidth": 2,
          "minorWidth": 1.5,
          "color": "$text-muted",
          "inset": 6
        },
        "labels": {
          "show": false,
          "every": 1,
          "style": {
            "font": "default",
            "size": 22,
            "weight": "medium",
            "color": "$text-muted",
            "align": "center",
            "baseline": "middle",
            "letterSpacing": 0,
            "uppercase": false
          },
          "divisor": 1000,
          "format": "0",
          "inset": 20
        },
        "needle": {
          "show": false,
          "color": "$accent",
          "width": 6,
          "length": 0.9,
          "tail": 0.1,
          "shape": "tapered",
          "cap": {
            "show": true,
            "radius": 14,
            "color": "$surface"
          }
        },
        "redline": {
          "show": false,
          "from": 6500,
          "color": "$danger",
          "width": 10,
          "placement": "outer"
        },
        "valueText": {
          "show": false,
          "style": {
            "font": "default",
            "size": 64,
            "weight": "bold",
            "color": "$text",
            "align": "center",
            "baseline": "middle",
            "letterSpacing": 0,
            "uppercase": false
          },
          "format": "0",
          "showUnit": false,
          "unitStyle": {
            "font": "default",
            "size": 22,
            "weight": "regular",
            "color": "$text",
            "align": "center",
            "baseline": "middle",
            "letterSpacing": 0,
            "uppercase": false
          },
          "offsetX": 0,
          "offsetY": 0
        },
        "glow": {
          "show": false,
          "color": "$accent",
          "blur": 18
        }
      }
    },
