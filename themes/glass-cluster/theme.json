{
  "schemaVersion": 1,
  "id": "glass-cluster",
  "name": "Glass Cluster",
  "version": "0.1.0",
  "author": "xingcici",
  "description": "CarPlay-inspired graphite instrument theme. Original design, not official CarPlay Ultra. Factory warning regions remain reserved.",
  "license": "GPL-3.0-or-later",
  "target": {
    "platform": "idrive7-mgu",
    "display": "kombi-id7-12.3",
    "renderer": "cluster-render"
  },
  "vehicleProfile": "turbo-ice",
  "layout": {
    "width": 1920,
    "height": 720,
    "background": "$background",
    "reservedZones": [
      {
        "x": 730,
        "y": 0,
        "width": 460,
        "height": 128,
        "id": "cowl",
        "name": "Top cowl (factory telltales)",
        "kind": "factory"
      },
      {
        "x": 1410,
        "y": 262,
        "width": 252,
        "height": 192,
        "id": "gear-bracket",
        "name": "Gear bracket (factory gear display)",
        "kind": "factory"
      },
      {
        "x": 1770,
        "y": 170,
        "width": 150,
        "height": 95,
        "id": "edrive-box",
        "name": "eDrive status box (hybrids)",
        "kind": "factory"
      },
      {
        "x": 560,
        "y": 652,
        "width": 960,
        "height": 68,
        "id": "telltales-bottom",
        "name": "Bottom telltale strip",
        "kind": "factory"
      },
      {
        "x": 0,
        "y": 0,
        "width": 394.5454545454545,
        "height": 217,
        "id": "glass-corner-left",
        "name": "Glass corner (left)",
        "kind": "keep-clear",
        "polygon": [
          {
            "x": 0,
            "y": 0
          },
          {
            "x": 394.5454545454545,
            "y": 0
          },
          {
            "x": 0,
            "y": 217
          }
        ]
      },
      {
        "x": 1525.4545454545455,
        "y": 0,
        "width": 394.5454545454545,
        "height": 217,
        "id": "glass-corner-right",
        "name": "Glass corner (right)",
        "kind": "keep-clear",
        "polygon": [
          {
            "x": 1920,
            "y": 0
          },
          {
            "x": 1525.4545454545455,
            "y": 0
          },
          {
            "x": 1920,
            "y": 217
          }
        ]
      },
      {
        "x": 416,
        "y": 120,
        "width": 1088,
        "height": 480,
        "id": "stock-map-window",
        "name": "Stock map window (slot 0x100)",
        "kind": "info"
      },
      {
        "x": 0,
        "y": 646,
        "width": 1920,
        "height": 74,
        "id": "bottom-strip",
        "name": "Bottom strip (black boxes reported below y 646)",
        "kind": "info"
      },
      {
        "x": 793,
        "y": 289,
        "width": 246,
        "height": 92,
        "id": "m-box-left",
        "name": "M cars: cluster box (approx. ±10 px)",
        "kind": "info"
      },
      {
        "x": 1223,
        "y": 328,
        "width": 171,
        "height": 78,
        "id": "m-box-right",
        "name": "M cars: cluster box (approx. ±10 px)",
        "kind": "info"
      },
      {
        "x": 740,
        "y": 128,
        "width": 440,
        "height": 19,
        "id": "driver-camera",
        "name": "Driver camera notch (cars with it, to y ≈ 147)",
        "kind": "info"
      }
    ]
  },
  "palettes": {
    "graphite": {
      "name": "Graphite",
      "colors": {
        "background": "#000000",
        "surface": "#15191f",
        "text": "#f4f6fa",
        "text-muted": "#a4adb9",
        "accent": "#9edaff",
        "track": "#29313b",
        "success": "#73d8b0",
        "warning": "#ffbd69",
        "danger": "#ff6969",
        "edge": "#ffffff24"
      }
    },
    "sport": {
      "name": "Sport",
      "colors": {
        "background": "#000000",
        "surface": "#15191f",
        "text": "#f4f6fa",
        "text-muted": "#a4adb9",
        "accent": "#ffb38d",
        "track": "#29313b",
        "success": "#73d8b0",
        "warning": "#ffbd69",
        "danger": "#ff6969",
        "edge": "#ffffff24"
      }
    },
    "eco": {
      "name": "Eco",
      "colors": {
        "background": "#000000",
        "surface": "#15191f",
        "text": "#f4f6fa",
        "text-muted": "#a4adb9",
        "accent": "#99dec5",
        "track": "#29313b",
        "success": "#73d8b0",
        "warning": "#ffbd69",
        "danger": "#ff6969",
        "edge": "#ffffff24"
      }
    }
  },
  "palette": {
    "default": "graphite",
    "byDriveMode": {
      "SPORT": "sport",
      "SPORT_PLUS": "sport",
      "ECO_PRO": "eco"
    },
    "allowManual": true
  },
  "fonts": {
    "default": {
      "family": "sans"
    }
  },
  "assets": {},
  "animations": {},
  "components": [
    {
      "id": "journey-card",
      "type": "rect",
      "x": 190,
      "y": 270,
      "width": 350,
      "height": 330,
      "props": {
        "radius": 32,
        "fill": {
          "type": "linear",
          "angle": 105,
          "stops": [
            {
              "offset": 0,
              "color": "#202630"
            },
            {
              "offset": 1,
              "color": "#0b0e13"
            }
          ]
        },
        "stroke": {
          "color": "$edge",
          "width": 1
        }
      }
    },
    {
      "id": "range-label",
      "type": "text",
      "x": 222,
      "y": 300,
      "width": 280,
      "height": 30,
      "props": {
        "text": "RANGE",
        "style": {
          "size": 19,
          "color": "$text-muted",
          "align": "left",
          "baseline": "middle",
          "weight": "medium"
        }
      }
    },
    {
      "id": "range-value",
      "type": "text",
      "x": 220,
      "y": 338,
      "width": 282,
      "height": 76,
      "props": {
        "text": "{value}",
        "style": {
          "size": 68,
          "color": "$text",
          "align": "left",
          "baseline": "middle",
          "weight": "medium"
        }
      },
      "binding": {
        "signal": "vehicle.range",
        "fallback": "dash"
      }
    },
    {
      "id": "range-unit",
      "type": "text",
      "x": 224,
      "y": 416,
      "width": 280,
      "height": 26,
      "props": {
        "text": "km remaining",
        "style": {
          "size": 20,
          "color": "$text-muted",
          "align": "left",
          "baseline": "middle",
          "weight": "medium"
        }
      }
    },
    {
      "id": "card-divider",
      "type": "line",
      "x": 222,
      "y": 466,
      "width": 286,
      "height": 1,
      "props": {
        "stroke": {
          "color": "$edge",
          "width": 1
        }
      }
    },
    {
      "id": "oil-label",
      "type": "text",
      "x": 224,
      "y": 492,
      "width": 270,
      "height": 26,
      "props": {
        "text": "Oil temperature",
        "style": {
          "size": 20,
          "color": "$text-muted",
          "align": "left",
          "baseline": "middle",
          "weight": "medium"
        }
      }
    },
    {
      "id": "oil-value",
      "type": "text",
      "x": 222,
      "y": 528,
      "width": 282,
      "height": 38,
      "props": {
        "text": "{value}°C",
        "style": {
          "size": 32,
          "color": "$text",
          "align": "left",
          "baseline": "middle",
          "weight": "medium"
        }
      },
      "binding": {
        "signal": "engine.oil.temp",
        "fallback": "dash"
      }
    },
    {
      "id": "revs",
      "name": "Rev arc",
      "x": 650,
      "y": 150,
      "width": 620,
      "height": 500,
      "rotation": 0,
      "opacity": 1,
      "visible": true,
      "locked": false,
      "anchor": "top-left",
      "binding": {
        "signal": "engine.rpm",
        "min": 0,
        "max": 7000,
        "scale": 1,
        "offset": 0,
        "clamp": true,
        "smoothing": 0.06,
        "fallback": "dash"
      },
      "animations": [],
      "type": "gauge.arc",
      "props": {
        "startAngle": 155,
        "sweepAngle": 230,
        "track": {
          "show": true,
          "color": "$track",
          "width": 8,
          "cap": "round"
        },
        "fill": {
          "show": true,
          "color": "$accent",
          "width": 8,
          "mode": "solid",
          "segments": 40,
          "segmentGap": 1.5,
          "cap": "round",
          "zones": [
            {
              "from": 6000,
              "to": 7000,
              "color": "$danger"
            }
          ]
        },
        "ticks": {
          "major": 7,
          "minor": 0,
          "majorLength": 9,
          "minorLength": 7,
          "majorWidth": 2,
          "minorWidth": 1.5,
          "color": "$text-muted",
          "inset": 6
        },
        "labels": {
          "show": true,
          "every": 1,
          "style": {
            "font": "default",
            "size": 22,
            "weight": "medium",
            "color": "$text-muted",
            "align": "center",
            "baseline": "middle",
            "letterSpacing": 0,
            "uppercase": false
          },
          "divisor": 1000,
          "format": "0",
          "inset": 20
        },
        "needle": {
          "show": false,
          "color": "$accent",
          "width": 6,
          "length": 0.9,
          "tail": 0.1,
          "shape": "tapered",
          "cap": {
            "show": true,
            "radius": 14,
            "color": "$surface"
          }
        },
        "redline": {
          "show": false,
          "from": 6500,
          "color": "$danger",
          "width": 10,
          "placement": "outer"
        },
        "valueText": {
          "show": false,
          "style": {
            "font": "default",
            "size": 64,
            "weight": "bold",
            "color": "$text",
            "align": "center",
            "baseline": "middle",
            "letterSpacing": 0,
            "uppercase": false
          },
          "format": "0",
          "showUnit": false,
          "unitStyle": {
            "font": "default",
            "size": 22,
            "weight": "regular",
            "color": "$text",
            "align": "center",
            "baseline": "middle",
            "letterSpacing": 0,
            "uppercase": false
          },
          "offsetX": 0,
          "offsetY": 0
        },
        "glow": {
          "show": false,
          "color": "$accent",
          "blur": 18
        }
      }
    },
    {
      "id": "rpm-caption",
      "type": "text",
      "x": 845,
      "y": 250,
      "width": 230,
      "height": 28,
      "props": {
        "text": "RPM x 1000",
        "style": {
          "size": 18,
          "color": "$text-muted",
          "align": "center",
          "baseline": "middle",
          "weight": "medium"
        }
      }
    },
    {
      "id": "speed",
      "name": "Speed",
      "x": 760,
      "y": 292,
      "width": 400,
      "height": 185,
      "rotation": 0,
      "opacity": 1,
      "visible": true,
      "locked": false,
      "anchor": "top-left",
      "binding": {
        "signal": "vehicle.speed",
        "scale": 1,
        "offset": 0,
        "clamp": true,
        "smoothing": 0,
        "fallback": "dash"
      },
      "animations": [],
      "type": "value.digital",
      "props": {
        "format": "0",
        "unit": "kmh",
        "showUnit": true,
        "label": "",
        "layout": "stacked",
        "valueStyle": {
          "font": "default",
          "size": 156,
          "weight": "light",
          "color": "$text",
          "align": "center",
          "baseline": "alphabetic",
          "letterSpacing": -3,
          "uppercase": false
        },
        "unitStyle": {
          "font": "default",
          "size": 24,
          "weight": "medium",
          "color": "$text-muted",
          "align": "center",
          "baseline": "alphabetic",
          "letterSpacing": 0,
          "uppercase": false
        },
        "labelStyle": {
          "font": "default",
          "size": 20,
          "weight": "regular",
          "color": "$text-muted",
          "align": "center",
          "baseline": "middle",
          "letterSpacing": 0,
          "uppercase": true
        },
        "zones": [],
        "radius": 0,
        "padding": 0,
        "tabular": true
      }
    },
    {
      "id": "gear-pill",
      "type": "rect",
      "x": 861,
      "y": 504,
      "width": 198,
      "height": 64,
      "props": {
        "radius": 32,
        "fill": {
          "type": "linear",
          "angle": 105,
          "stops": [
            {
              "offset": 0,
              "color": "#202630"
            },
            {
              "offset": 1,
              "color": "#0b0e13"
            }
          ]
        },
        "stroke": {
          "color": "$edge",
          "width": 1
        }
      }
    },
    {
      "id": "gear",
      "name": "Gear",
      "x": 881,
      "y": 514,
      "width": 68,
      "height": 42,
      "rotation": 0,
      "opacity": 1,
      "visible": true,
      "locked": false,
      "anchor": "top-left",
      "binding": {
        "signal": "transmission.gear",
        "scale": 1,
        "offset": 0,
        "clamp": true,
        "smoothing": 0,
        "fallback": "dash"
      },
      "animations": [],
      "type": "indicator.gear",
      "props": {
        "style": {
          "font": "default",
          "size": 36,
          "weight": "medium",
          "color": "$text",
          "align": "center",
          "baseline": "middle",
          "letterSpacing": 0,
          "uppercase": false
        },
        "showMode": false,
        "modeStyle": {
          "font": "default",
          "size": 36,
          "weight": "regular",
          "color": "$text-muted",
          "align": "center",
          "baseline": "middle",
          "letterSpacing": 0,
          "uppercase": false
        },
        "modeSignal": "transmission.mode",
        "mapping": {},
        "radius": 0
      }
    },
    {
      "id": "drive-mode",
      "type": "text",
      "x": 951,
      "y": 522,
      "width": 90,
      "height": 24,
      "props": {
        "text": "{value}",
        "style": {
          "size": 16,
          "color": "$accent",
          "align": "left",
          "baseline": "middle",
          "weight": "medium"
        }
      },
      "binding": {
        "signal": "drive.mode",
        "fallback": "dash"
      }
    },
    {
      "id": "clock",
      "type": "clock",
      "x": 1380,
      "y": 174,
      "width": 220,
      "height": 46,
      "props": {
        "format": "24h",
        "style": {
          "size": 36,
          "color": "$text",
          "align": "left",
          "baseline": "middle"
        }
      }
    },
    {
      "id": "outside-temp",
      "type": "text",
      "x": 1380,
      "y": 224,
      "width": 220,
      "height": 28,
      "props": {
        "text": "{value}°C",
        "style": {
          "size": 22,
          "color": "$text-muted",
          "align": "left",
          "baseline": "middle",
          "weight": "medium"
        }
      },
      "binding": {
        "signal": "environment.outside.temp",
        "fallback": "dash"
      }
    },
    {
      "id": "fuel-card",
      "type": "rect",
      "x": 1370,
      "y": 480,
      "width": 350,
      "height": 120,
      "props": {
        "radius": 32,
        "fill": {
          "type": "linear",
          "angle": 105,
          "stops": [
            {
              "offset": 0,
              "color": "#202630"
            },
            {
              "offset": 1,
              "color": "#0b0e13"
            }
          ]
        },
        "stroke": {
          "color": "$edge",
          "width": 1
        }
      }
    },
    {
      "id": "fuel-label",
      "type": "text",
      "x": 1402,
      "y": 500,
      "width": 130,
      "height": 26,
      "props": {
        "text": "FUEL",
        "style": {
          "size": 18,
          "color": "$text-muted",
          "align": "left",
          "baseline": "middle",
          "weight": "medium"
        }
      }
    },
    {
      "id": "fuel-value",
      "type": "text",
      "x": 1550,
      "y": 497,
      "width": 136,
      "height": 30,
      "props": {
        "text": "{value}%",
        "style": {
          "size": 25,
          "color": "$text",
          "align": "right",
          "baseline": "middle",
          "weight": "medium"
        }
      },
      "binding": {
        "signal": "fuel.level",
        "fallback": "dash"
      }
    },
    {
      "id": "fuel-bar",
      "type": "gauge.bar",
      "x": 1402,
      "y": 553,
      "width": 286,
      "height": 7,
      "props": {
        "track": {
          "color": "$track",
          "radius": 4
        },
        "fill": {
          "color": "$accent",
          "radius": 4,
          "zones": [
            {
              "from": 0,
              "to": 15,
              "color": "$warning"
            }
          ]
        }
      },
      "binding": {
        "signal": "fuel.level",
        "fallback": "dash",
        "min": 0,
        "max": 100
      }
    }
  ]
}
